APP_NAME=Agendou
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://agendou.seudominio.com.br

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=agendou
DB_USERNAME=agendou
DB_PASSWORD=senha-forte-aqui

QUEUE_CONNECTION=database
QUEUE_HEARTBEAT_WORKERS=interactive,batch
QUEUE_HEARTBEAT_INTERVAL_SECONDS=15
QUEUE_WORKER_STALE_AFTER_SECONDS=60
SCHEDULER_STALE_AFTER_SECONDS=150
SESSION_DRIVER=file
CACHE_STORE=database

EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=sua-chave-aqui

CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ordem de IA em produção:
# 1. Groq / Qwen 3.8 27B
# 2. Groq / GPT-OSS 20B
# 3. Cloudflare Workers AI
# 4. Gemini
# 5. OpenRouter Free
AI_PROVIDER=groq_qwen
AI_FALLBACK_PROVIDERS=groq_gpt_oss,cloudflare,gemini,openrouter
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_TOKEN_LIMIT=
AI_MONTHLY_COST_LIMIT_USD=

# As duas rotas Groq compartilham a mesma chave.
GROQ_API_KEY=
GROQ_QWEN_MODEL=qwen/qwen3.8-27b
GROQ_GPT_OSS_MODEL=openai/gpt-oss-20b
# Compatibilidade com tenants antigos que ainda usem provider=groq.
GROQ_MODEL=openai/gpt-oss-20b

# Workers AI usa endpoint OpenAI-compatible:
# https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1/chat/completions
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b
# Opcional. Se vazio, a URL é montada a partir de CLOUDFLARE_ACCOUNT_ID.
CLOUDFLARE_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

ASAAS_API_KEY=sua-chave-asaas
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_SECRET=
TRIAL_DAYS=14

# E-mail que recebe alerta quando uma exceção PHP não tratada acontece em produção
ERROR_ALERT_EMAIL=joaopedro-freela@gmail.com
ERROR_ALERT_THROTTLE_MINUTES=15

# Token para o endpoint GET /monitor/erros (monitoramento externo, somente leitura).
# Gere um valor forte e único, por exemplo: openssl rand -hex 32
MONITOR_API_TOKEN=

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
AUTH_PASSWORD_TIMEOUT=900
# Credenciais exigidas apenas ao executar os seeders administrativos.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# Credenciais exigidas somente ao executar manualmente OdontoExcellenceSeeder.
ODONTO_SEEDER_EMAIL=
ODONTO_SEEDER_PASSWORD=
ODONTO_SEEDER_WHATSAPP=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Em produção, o sistema força cookies Secure e sessões criptografadas.
# Limite aos IPs/CIDRs do proxy reverso. O padrão cobre Caddy/Docker local.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_HEARTBEAT_WORKERS=interactive,batch
QUEUE_HEARTBEAT_INTERVAL_SECONDS=15
QUEUE_WORKER_STALE_AFTER_SECONDS=60
SCHEDULER_STALE_AFTER_SECONDS=150

# Segundos de espera antes do bot responder, agrupando mensagens rápidas do cliente (0 = desabilitado)
BOT_DEBOUNCE_SECONDS=5

# Orquestração de IA (chaves permanecem somente no backend)
# Prioriza provedores com free tier; Claude fica como último fallback pago.
AI_PROVIDER=gemini
# Ordem de fallback. Deixe vazio para não fazer fallback.
AI_FALLBACK_PROVIDERS=groq,openrouter,claude
AI_TIMEOUT_SECONDS=30
AI_MONTHLY_TOKEN_LIMIT=
AI_MONTHLY_COST_LIMIT_USD=

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# E-mail que recebe alerta quando uma exceção PHP não tratada acontece em produção
ERROR_ALERT_EMAIL=
ERROR_ALERT_THROTTLE_MINUTES=15

# Token para o endpoint GET /monitor/erros (monitoramento externo, somente leitura)
MONITOR_API_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
